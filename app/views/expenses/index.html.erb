<% content_for :title, "Expenses — Diversity" %>

<div class="page-header">
  <h1>Expenses</h1>
</div>

<% if @expenses.empty? %>
  <div class="empty-state">
    <p>No expenses yet. <%= link_to "Record your first expense", new_expense_path %></p>
  </div>
<% else %>
  <table class="data-table">
    <thead>
      <tr>
        <th>Date</th>
        <th>Description</th>
        <th>Category</th>
        <th class="text-right">Amount</th>
        <th>Allocated from</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @expenses.each do |expense| %>
        <tr>
          <td><%= expense.date.strftime("%d.%m.%Y") %></td>
          <td><%= link_to expense.description, expense %></td>
          <td><%= expense.category.presence || "—" %></td>
          <td class="text-right"><%= number_to_currency(expense.amount, unit: "", precision: 2) %></td>
          <td>
            <% expense.expense_allocations.each do |alloc| %>
              <div class="allocation-chip">
                <%= link_to alloc.card_top_up.description.presence || alloc.card_top_up.source_type.capitalize, alloc.card_top_up %>
                (<%= number_to_currency(alloc.amount, unit: "", precision: 2) %>)
              </div>
            <% end %>
          </td>
          <td class="actions">
            <%= link_to "Edit", edit_expense_path(expense), class: "btn btn-sm" %>
            <%= button_to "Delete", expense, method: :delete, class: "btn btn-sm btn-danger",
                data: { turbo_confirm: "Delete this expense?" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
    <tfoot>
      <tr>
        <td colspan="3"><strong>Total</strong></td>
        <td class="text-right"><strong><%= number_to_currency(@expenses.sum(&:amount), unit: "", precision: 2) %></strong></td>
        <td colspan="2"></td>
      </tr>
    </tfoot>
  </table>
<% end %>
